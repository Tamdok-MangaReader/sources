        },
        {
          "type": "text",
          "id": "username",
          "title": "Username (if no API key)",
          "default": ""
        },
        {
          "type": "text",
          "id": "password",
          "title": "Password",
          "default": "",
          "secure": true
        }
      ]
    },
    {
      "type": "group",
      "title": "OTHER",
      "items": [
        {
          "type": "link",
          "id": "docs",
          "title": "Kavita documentation",
          "url": "https://wiki.kavitareader.com"
        }
      ]
    }
  ]
}